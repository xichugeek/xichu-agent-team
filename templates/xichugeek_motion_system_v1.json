{
  "kind": "design_template",
  "version": "1.0",
  "name": "XichuGeek Motion System",
  "implementation_state": "design_only",
  "format": {
    "width": 1920,
    "height": 1080,
    "fps": 60
  },
  "contract": {
    "shotModes": [
      "live",
      "replay",
      "diagram",
      "generated_visual"
    ],
    "extends_existing_studio_contracts": true,
    "adds_gate": false,
    "adds_artifact_state": false
  },
  "theme": {
    "background": "#0B0F14",
    "surface": "#151C25",
    "foreground": "#F3F5F7",
    "muted": "#8C98A8",
    "structure": "#3B495B",
    "active": "#72C9DB",
    "pass": "#9CD3B0",
    "spacingUnit": 8,
    "margin": 96,
    "titleSize": 72,
    "bodySize": 40,
    "codeSize": 32,
    "sourceSize": 26,
    "subtitleSafeRect": {
      "x": 96,
      "y": 900,
      "width": 1728,
      "height": 140
    },
    "contentRect": {
      "x": 96,
      "y": 96,
      "width": 1728,
      "height": 764
    }
  },
  "motion": {
    "entryFrames": 30,
    "exitFrames": 20,
    "staggerFrames": 8,
    "cameraFrames": 42,
    "minimumTextHoldFrames": 120,
    "overshootClamping": true,
    "springConfigDesign": {
      "damping": 100,
      "stiffness": 100,
      "mass": 1
    },
    "require_actual_60fps_preview": true
  },
  "pipeline": {
    "meaning": "delivery_relationship_and_narrative_reveal",
    "nodeIds": [
      "idea",
      "prompt",
      "codex",
      "source",
      "build",
      "image",
      "nginx",
      "container",
      "proxy",
      "https",
      "demo",
      "github",
      "project"
    ],
    "labels": [
      "IDEA",
      "PROMPT",
      "CODEX",
      "SOURCE CODE",
      "ASTRO BUILD",
      "DOCKER IMAGE",
      "NGINX",
      "CONTAINER",
      "REVERSE PROXY",
      "HTTPS",
      "LIVE DEMO",
      "GITHUB",
      "XICHUGEEK PROJECT"
    ],
    "visualStates": [
      "gray",
      "active",
      "pass"
    ],
    "passRequires": [
      "evidenceIds",
      "statusBasis",
      "scope",
      "historyPhase"
    ],
    "layout": {
      "kind": "fixed_serpentine_4_columns",
      "nodeWidth": 344,
      "nodeHeight": 118,
      "columnsX": [
        120,
        560,
        1000,
        1440
      ],
      "rowsY": [
        152,
        342,
        532,
        722
      ],
      "nodeCoordinates": [
        [
          120,
          152
        ],
        [
          560,
          152
        ],
        [
          1000,
          152
        ],
        [
          1440,
          152
        ],
        [
          1440,
          342
        ],
        [
          1000,
          342
        ],
        [
          560,
          342
        ],
        [
          120,
          342
        ],
        [
          120,
          532
        ],
        [
          560,
          532
        ],
        [
          1000,
          532
        ],
        [
          1440,
          532
        ],
        [
          1440,
          722
        ]
      ]
    }
  },
  "components": {
    "XGPrompt": {
      "commonProps": [
        "frame",
        "fps",
        "theme",
        "sourceMode",
        "evidenceIds",
        "sourceCaption",
        "privacyCheck",
        "focusRect",
        "subtitleSafeRect",
        "entryFrames",
        "holdFrames",
        "exitFrames"
      ],
      "props": [
        "quoteId",
        "quoteLines",
        "attachmentLabel",
        "focusLines",
        "verifiedQuote"
      ],
      "guard": "No fabricated historical input or typing. Attachment identity visible."
    },
    "XGTerminal": {
      "commonProps": [
        "frame",
        "fps",
        "theme",
        "sourceMode",
        "evidenceIds",
        "sourceCaption",
